","\u001b[2K    Uninstalling torchvision-0.24.0+cu126:\n","\u001b[2K      Successfully uninstalled torchvision-0.24.0+cu126\n","\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m20/20\u001b[0m [fastai]\n","\u001b[1A\u001b[2K\u001b[31mERROR: pip's dependency resolver does not currently take into account all the packages that are installed. This behaviour is the source of the following dependency conflicts.\n","python-fasthtml 0.12.37 requires fastcore>=1.10.0, but you have fastcore 1.7.29 which is incompatible.\n","torchaudio 2.9.0+cu126 requires torch==2.9.0, but you have torch 2.6.0 which is incompatible.\u001b[0m\u001b[31m\n","\u001b[0mSuccessfully installed fastai-2.7.19 fastcore-1.7.29 fastprogress-1.0.5 nvidia-cublas-cu12-12.4.5.8 nvidia-cuda-cupti-cu12-12.4.127 nvidia-cuda-nvrtc-cu12-12.4.127 nvidia-cuda-runtime-cu12-12.4.127 nvidia-cudnn-cu12-9.1.0.70 nvidia-cufft-cu12-11.2.1.3 nvidia-curand-cu12-10.3.5.147 nvidia-cusolver-cu12-11.6.1.9 nvidia-cusparse-cu12-12.3.1.170 nvidia-cusparselt-cu12-0.6.2 nvidia-nccl-cu12-2.21.5 nvidia-nvjitlink-cu12-12.4.127 nvidia-nvtx-cu12-12.4.127 sympy-1.13.1 torch-2.6.0 torchvision-0.21.0 triton-3.2.0\n"]},{"output_type":"execute_result","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["\n","alert(\n","  \"SETUP COMPLETE\\n\\n\" +\n","  \"STOP now.\\n\\n\" +\n","  \"Click: Runtime → Restart session\\n\\n\" +\n","  \"Only proceed after the runtime has restarted.\"\n",");\n"]},"metadata":{},"execution_count":4}]},{"cell_type":"code","source":["### Creating file structure for input upload/output/model weights\n","\n","import os\n","# List of directories to check and create\n","directories = [\n","    'model',\n","    'input',\n","    'output',\n","    'model/weights',\n","    'model/trained'\n","]\n","\n","# Loop through each directory and create if it doesn't exist\n","for directory in directories:\n","    if not os.path.exists(directory):\n","        os.makedirs(directory)\n","        print(f\"Directory '{directory}' created.\")\n","    else:\n","        print(f\"Directory '{directory}' already exists.\")\n","\n","# Define file paths\n","input_data_dir = 'model/input_data'\n","trained_dir = 'model/trained'\n","weights_dir = 'model/weights'"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"mWo00LF6spqS","executionInfo":{"status":"ok","timestamp":1769008769303,"user_tz":0,"elapsed":14,"user":{"displayName":"samshabapp","userId":"17072432894550383827"}},"outputId":"b48435d4-5614-469c-86ec-75d97c7ef774"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Directory 'model' created.\n","Directory 'input' created.\n","Directory 'output' created.\n","Directory 'model/weights' created.\n","Directory 'model/trained' created.\n"]}]},{"cell_type":"markdown","source":["# Time interval for frame extraction\n","\n"],"metadata":{"id":"6YpSCmUd42sR"}},{"cell_type":"code","source":["# Time interval for frame extraction (in seconds)\n","\n","time_interval = 5"],"metadata":{"id":"wL6cA3t7vJqq"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["### Checks needed fiels are present\n","\n","import os\n","\n","# Check if the user has uploaded required files\n","got_coord_file = False\n","got_video_file = False\n","\n","# Define the input directory and accepted formats\n","input_dir = './input'\n","accepted_coord_formats = ['.csv', '.txt']\n","accepted_video_formats = ['.mp4', '.mov', '.m2ts','.avi']\n","\n","# Check if the input directory exists\n","if os.path.exists(input_dir):\n","    files = os.listdir(input_dir)\n","    print(f\"Files in directory: {files}\")\n","\n","    # Iterate over the files and check their formats\n","    for file in files:\n","        if file.endswith(tuple(accepted_coord_formats)):\n","            coords = \"input/\"+file  # Assign the coordinate file name\n","            got_coord_file = True\n","        if file.endswith(tuple(accepted_video_formats)):\n","            inputVideo = \"input/\" + file  # Assign the video file name\n","            got_video_file = True\n","else:\n","    print(f\"Directory {input_dir} does not exist. Please create it and upload your files.\")\n","\n","# Check for missing files and display a message\n","if not got_coord_file or not got_video_file:\n","    print(f\"STOP! You need to upload both a coordinate file ({', '.join(accepted_coord_formats)}) \"\n","          f\"and a video file ({', '.join(accepted_video_formats)}) to the {input_dir} directory before proceeding.\")\n","else:\n","    print(f\"All required files are present. Coordinate file: {coords}, Video file: {inputVideo}. You may proceed.\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"3z3b1JLrh4yr","executionInfo":{"status":"ok","timestamp":1769008772263,"user_tz":0,"elapsed":8,"user":{"displayName":"samshabapp","userId":"17072432894550383827"}},"outputId":"617b3007-3b6d-4dae-8757-7ff98db10280"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Files in directory: []\n","STOP! You need to upload both a coordinate file (.csv, .txt) and a video file (.mp4, .mov, .m2ts, .avi) to the ./input directory before proceeding.\n"]}]},{"cell_type":"code","source":["import os\n","import cv2\n","import numpy as np\n","import pandas as pd\n","import ffmpeg\n","from PIL import Image\n","from fastai.vision.all import *\n","from datetime import datetime, timedelta\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","import mplleaflet\n","from contextlib import contextmanager\n","import pathlib\n","import torch\n","import requests\n","import wget\n","from pathlib import Path\n","print(\"imported libraries\")"],"metadata":{"id":"VwGHYWSoBdKV","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1769008812551,"user_tz":0,"elapsed":18633,"user":{"displayName":"samshabapp","userId":"17072432894550383827"}},"outputId":"51108cd9-a2e2-421d-eeac-0a9f4e896491"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["imported libraries\n"]}]},{"cell_type":"code","source":["os.chdir(\"/content/\")"],"metadata":{"id":"wBBsPuLnpBO9"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":[],"metadata":{"id":"uDJxSdBHP8qc"}},{"cell_type":"markdown","source":["# Fetch model data\n","\n","SEA-AI will download trained models\n"],"metadata":{"id":"zLBm9IO4AMTT"}},{"cell_type":"markdown","source":["<a name=\"weights-clip-section\"></a>\n","## Model weights for object detection"],"metadata":{"id":"T9TnA4uulGlU"}},{"cell_type":"code","source":["getModelWeight = wget.download(url= 'https://thredds.sams.ac.uk/thredds/fileServer/models/weights/best_FE_2023-08-07_22-36.pt', out = \"model/weights\")"],"metadata":{"id":"-ZEKXnM6hH-J"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["<a name=\"trained-model-section\"></a>\n","## Model weights for image classification"],"metadata":{"id":"DvkpdgS_mb7r"}},{"cell_type":"code","source":["getTrainedModel = wget.download(url= 'https://thredds.sams.ac.uk/thredds/fileServer/models/trained/F-JuraIslay_model_binary_Mixup_b7_bs4_720_1280_01_08.pkl', out = \"model/trained\")"],"metadata":{"id":"_mHg-DA6mhJi"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Find the trained model file in the trained directory\n","trainedModel = None\n","for file in os.listdir(trained_dir):\n","    if file.endswith(('.pkl', '.h5', '.pt', '.pth')):  # Add any other extensions your model files may have\n","        trainedModel = os.path.join(trained_dir, file)\n","        print(f\"Trained model file found: {trainedModel}\")\n","        break\n","\n","# Find the weights file in the weights directory\n","modelWeights = None\n","for file in os.listdir(weights_dir):\n","    if file.endswith(('.pt', '.weights', '.h5')):  # Adjust extensions based on your weight files\n","        modelWeights = os.path.join(weights_dir, file)\n","        print(f\"Weights file found: {modelWeights}\")\n","        break\n","\n","\n","# Output variables\n","print(f\"Coordinates file: {coords}\")\n","print(f\"Video file: {inputVideo}\")\n","print(f\"Model file: {trainedModel}\")\n","print(f\"Weights file: {modelWeights}\")\n"],"metadata":{"id":"QTqBGk27inrg","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1768930588900,"user_tz":0,"elapsed":3,"user":{"displayName":"John Halpin","userId":"12118561363890903648"}},"outputId":"8f2ed4d5-f01a-41a6-c053-5fb3c2592532"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Trained model file found: model/trained/F-JuraIslay_model_binary_Mixup_b7_bs4_720_1280_01_08.pkl\n","Weights file found: model/weights/best_FE_2023-08-07_22-36.pt\n","Coordinates file: input/Lismore_Maerl_Beds_SAMS.csv\n","Video file: input/Lismore_Maerl_Beds_SAMS.mp4\n","Model file: model/trained/F-JuraIslay_model_binary_Mixup_b7_bs4_720_1280_01_08.pkl\n","Weights file: model/weights/best_FE_2023-08-07_22-36.pt\n"]}]},{"cell_type":"code","source":["\n","\n","\n"],"metadata":{"id":"Iiw9hnYAx-w_"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["# Run the code below to process the transect footage\n"],"metadata":{"id":"VkQX6WnGPSKx"}},{"cell_type":"code","source":["\n","# This conde snnipet is necessary to run in case the model has been trained in Linux\n","@contextmanager\n","def set_posix_windows():\n","    posix_backup = pathlib.PosixPath\n","    try:\n","        pathlib.PosixPath = pathlib.WindowsPath\n","        yield\n","    finally:\n","        pathlib.PosixPath = posix_backup\n","\n","# Preprocess datetime\n","\n","coords = pd.read_csv(coords)\n","coords['datetime'] = coords['date'] + ' ' + coords['time']  # Concatenate date and time columns\n","coords['datetime'] = coords['datetime'].astype('datetime64[ns]')  # Convert to datetime\n","coords['UNIXtime'] = (coords['datetime'] - pd.Timestamp(\"1970-01-01\")) // pd.Timedelta(\n","    '1millisecond')  # Create UNIX time column\n","coords = coords.drop(columns=['date', 'time'])  # Drop date and time columns\n","coords = coords.set_index('datetime', drop=True)  # Set the new column DateTime as the index\n","\n","# Temp output folder\n","folder_out = './output/video_frames_test'\n","if os.path.exists(folder_out):\n","    shutil.rmtree(folder_out)\n","os.makedirs(folder_out)\n","\n","# Yolo output folder\n","folder_out_yolo = './output/yolo_predict'\n","if os.path.exists(folder_out_yolo):\n","    shutil.rmtree(folder_out_yolo)\n","os.makedirs(folder_out_yolo)\n","\n","# Initialize video capture\n","cap = cv2.VideoCapture(inputVideo)\n","\n","# Get the start time from the video metadata using ffmpeg\n","# probe = ffmpeg.probe(video_path)\n","# creation_time = probe['streams'][0]['tags']['creation_time']\n","# creation_time = creation_time.replace('T', ' ').replace('Z', '')\n","\n","# If the start time is not available in the metada > Add it manually (for example: '2019-06-21 09:21:47.000')\n","# creation_time = '2019-06-21 09:21:47.000'\n","#creation_time = '2019-10-04 07:44:50.000'\n","creation_time = coords.index[0]\n","creation_time_datetime=creation_time\n","\n","# Convert the creation time string to a datetime object\n","##creation_time_datetime = datetime.strptime(creation_time, '%Y-%m-%d %H:%M:%S.%f')\n","creation_time_datetime=creation_time\n","\n","# Create lists to store the data\n","timestamp_list = []\n","filename_list = []\n","prediction_list = []\n","latitude_list = []\n","longitude_list = []\n","image_path_list = []\n","BurrowingSeaCucumber_list = []\n","HorseMussel_list = []\n","NorthernSeaFan_list = []\n","\n","\n","# Loading a model trained in Linux\n","model_path = pathlib.Path(trainedModel)\n","\n","# with set_posix_windows():\n","learner = load_learner(trainedModel)\n","\n","# Load trained model trained in Windows\n","# learner = load_learner('./F-JuraIslay_model_binary_Mixup_b7_bs4_720_1280_01_08.pkl', cpu=False)\n","\n","model_yolo = torch.hub.load('yolov5', 'custom',path = modelWeights, source='local')\n","\n","# Time interval for frame extraction (in seconds)\n","time_interval = 5\n","\n","# Loop over video frames\n","frame_index = 0\n","current_time = 0\n","print(\"processing video!\")\n","while cap.isOpened():\n","    # Read the frame\n","    ret, frame = cap.read()\n","    if not ret:\n","        break\n","\n","    # Get the frame timestamp (in seconds)\n","    frame_timestamp = cap.get(cv2.CAP_PROP_POS_MSEC) / 1000.0\n","\n","    # Check if the frame is within the current time interval\n","    if frame_timestamp >= current_time:\n","\n","        # Calculate the new frame timestamp by adding frame_timestamp to the creation_time\n","        new_frame_timestamp_datetime = creation_time_datetime + timedelta(seconds=frame_timestamp)\n","\n","        # Convert to UNIX time (for interpolation step)\n","        new_frame_timestamp_unix = (new_frame_timestamp_datetime - pd.Timestamp(\"1970-01-01\")) // pd.Timedelta(\n","            '1millisecond')\n","\n","        # Convert the new frame timestamp back to string with desired format\n","        new_frame_timestamp = new_frame_timestamp_datetime.strftime('%Y-%m-%d_%H-%M-%S.%f')\n","\n","        # Preprocess the frame and convert it to a PIL Image\n","        frame_pil = Image.fromarray(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))\n","\n","        # Perform inference on the image\n","        pred, _, _ = learner.predict(frame_pil)\n","\n","        if pred == 'maerl':\n","          pred='Yes'\n","        else:\n","          pred='No'\n","\n","        model_yolo.conf = 0.7\n","        iou = 0.7\n","        yolo_results = model_yolo(frame_pil)\n","\n","        # Save the frame with the timestamp and predicted class label\n","        filename = f\"Frame_{new_frame_timestamp}_{frame_index:04d}.jpg\"\n","        image_path = os.path.join(folder_out, filename)\n","        frame_pil.save(image_path)\n","\n","        # save the yolo results\n","        image_path_yolo = os.path.join(folder_out_yolo, filename)\n","        # yolo_results.save(save_dir=image_path_yolo)\n","        Image.fromarray(yolo_results.render()[0]).save(image_path_yolo)\n","\n","        # Convert yolo predictions\n","        if yolo_results.pandas().xyxy[0].empty == False:\n","            # print('detection')\n","            if 0 in np.array(yolo_results.pandas().xyxy[0]['class'].pop(0)):\n","                BurrowingSeaCucumber = 'Yes'\n","            else:\n","                BurrowingSeaCucumber = 'No'\n","\n","            if 1 in np.array(yolo_results.pandas().xyxy[0]['class'].pop(0)):\n","                HorseMussel = 'Yes'\n","            else:\n","                HorseMussel = 'No'\n","\n","            if 2 in np.array(yolo_results.pandas().xyxy[0]['class'].pop(0)):\n","                NorthernSeaFan = 'Yes'\n","            else:\n","                NorthernSeaFan = 'No'\n","\n","        else:\n","            NorthernSeaFan = 'No'\n","            HorseMussel = 'No'\n","            BurrowingSeaCucumber = 'No'\n","        # Add data to the respective lists\n","        timestamp_list.append(new_frame_timestamp)\n","        filename_list.append(filename)\n","        prediction_list.append(pred)\n","        image_path_list.append(image_path)\n","        BurrowingSeaCucumber_list.append(BurrowingSeaCucumber)\n","        HorseMussel_list.append(HorseMussel)\n","        NorthernSeaFan_list.append(NorthernSeaFan)\n","        # Check if the frame timestamp exists in the CSV data\n","        matching_row = coords.loc[coords.index == new_frame_timestamp_datetime]\n","        if not matching_row.empty:\n","            # Get the latitude and longitude directly from the CSV data\n","            latitude = matching_row['latitude'].iloc[0]\n","            longitude = matching_row['longitude'].iloc[0]\n","        else:\n","            # Interpolate the location for the frame timestamp\n","            timestamp_series = coords['UNIXtime']\n","            latitude_series = coords['latitude']\n","            longitude_series = coords['longitude']\n","\n","            # Get the latitude and longitude values\n","            # print(coords['UNIXtime'])\n","            # print(new_frame_timestamp_unix)\n","            latitude = np.interp(new_frame_timestamp_unix, coords['UNIXtime'], coords['latitude'])\n","            longitude = np.interp(new_frame_timestamp_unix, coords['UNIXtime'], coords['longitude'])\n","\n","        latitude_list.append(latitude)\n","        longitude_list.append(longitude)\n","\n","        frame_index += 1\n","        current_time += time_interval\n","\n","# Create a new DataFrame with the extracted data\n","output_df = pd.DataFrame({\n","    'Time': timestamp_list,\n","    'Filename': filename_list,\n","    'Latitude': latitude_list,\n","    'Longitude': longitude_list,\n","    'Path': image_path_list,\n","    'BurrowingSeaCucumber': BurrowingSeaCucumber_list,\n","    'HorseMussel': HorseMussel_list,\n","    'NorthernSeaFan': NorthernSeaFan_list,\n","    'Maerl': prediction_list\n","})\n","\n","# Release the video capture object\n","cap.release()\n","\n","# Display/Export the output DataFrame\n","# print(output_df)\n","csv_save_name=Path(inputVideo).stem+\"_out.csv\"\n","output_df.to_csv(csv_save_name)\n","'''\n","\n","'''\n"],"metadata":{"id":"yObExH6EnG1C","colab":{"base_uri":"https://localhost:8080/","height":550},"executionInfo":{"status":"error","timestamp":1768930593069,"user_tz":0,"elapsed":176,"user":{"displayName":"John Halpin","userId":"12118561363890903648"}},"outputId":"25b7afc0-6e89-4321-800d-19e9e571cdeb"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stderr","text":["/usr/local/lib/python3.12/dist-packages/fastai/learner.py:455: UserWarning: load_learner` uses Python's insecure pickle module, which can execute malicious arbitrary code when loading. Only load files you trust.\n","If you only need to load model weights and optimizer 